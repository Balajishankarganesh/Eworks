# ============================================================
# Home Services Marketplace — Environment Variables Example
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Django ------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL + PostGIS) -----------------------
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=homeservices
DB_USER=homeservices_user
DB_PASSWORD=homeservices_pass
DB_HOST=db
DB_PORT=5432

# ---- Redis -------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Django Channels ---------------------------------------
CHANNEL_LAYERS_HOST=redis

# ---- JWT Auth ----------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Google OAuth ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- CORS --------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Media / Static ----------------------------------------
MEDIA_URL=/media/
STATIC_URL=/static/

# ---- Email (for notifications) ----------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---- Frontend ----------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws

# ---- Matching Engine ---------------------------------------
OFFER_BATCH_SIZE=3
OFFER_EXPIRY_SECONDS=30
MATCHING_RADIUS_KM=10

# ---- Payments (optional) -----------------------------------
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Sentry (optional) ------------------------------------
SENTRY_DSN=
